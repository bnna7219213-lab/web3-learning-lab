{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minichain.local/schema/evidence-package/1.json",
  "title": "Evidence Package v1（M4 企业可信档案 · 出证包）",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "evidenceId", "subject", "batch", "algorithm", "leaf", "root", "proof", "anchor", "status", "validity", "issuer"],
  "properties": {
    "schema": { "const": "minichain.evidence/1" },
    "evidenceId": { "type": "string", "pattern": "^ev_[A-Za-z0-9_-]{6,64}$" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["document", "settlement-batch", "device-reading", "entitlement", "inspection-report"] },
        "id": { "type": "string", "pattern": "^[A-Za-z0-9:._-]{3,128}$" },
        "displayName": { "type": "string", "maxLength": 200 }
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batchId", "leafCount", "issuedAt"],
      "properties": {
        "batchId": { "type": "string", "pattern": "^[A-Za-z0-9:._-]{3,128}$" },
        "leafCount": { "type": "integer", "minimum": 1 },
        "issuedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" }
      }
    },
    "algorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "variant", "leafPrefix", "nodePrefix", "oddLeaf"],
      "properties": {
        "name": { "const": "sha256-merkle" },
        "variant": { "enum": ["v1-domain-separated", "v2-indexed"] },
        "leafPrefix": { "type": "string" },
        "nodePrefix": { "type": "string" },
        "oddLeaf": { "enum": ["duplicate-last", "indexed-position"] }
      }
    },
    "leaf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "leafHash", "disclosure"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "leafHash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
        "disclosure": { "enum": ["full", "hash-only"] },
        "data": { "type": "string" },
        "dataEncoding": { "enum": ["utf8", "base64"] }
      }
    },
    "root": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "proof": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hash", "position"],
        "properties": {
          "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
          "position": { "enum": ["left", "right"] },
          "level": { "type": "integer", "minimum": 0 },
          "siblingIndex": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chainProfile", "chainId", "contract", "txHash", "blockNumber", "topicRoot", "confirmationsRequired"],
      "properties": {
        "chainProfile": { "enum": ["unionchain", "sepolia", "base-sepolia", "anvil", "other-evm"] },
        "chainId": { "type": "integer", "minimum": 0 },
        "contract": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "txHash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
        "blockHash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
        "blockNumber": { "type": "integer", "minimum": 0 },
        "logIndex": { "type": "integer", "minimum": 0 },
        "topicRoot": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
        "confirmationsRequired": { "type": "integer", "minimum": 1 },
        "explorerUrl": { "type": "string" },
        "notaryRef": { "type": "string" },
        "rpcUrl": { "type": "string" }
      }
    },
    "status": { "enum": ["anchored", "confirmed", "voided"] },
    "void": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "at"],
      "properties": {
        "reason": { "enum": ["reorg", "issuer-revoked", "source-corrected", "expired"] },
        "at": { "type": "string" },
        "replacement": { "type": "string" }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuedAt"],
      "properties": {
        "issuedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
        "expiresAt": { "type": "string" }
      }
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "keyId", "address", "signature", "signedFields"],
      "properties": {
        "name": { "type": "string" },
        "keyId": { "type": "string", "pattern": "^[A-Za-z0-9:._-]{3,64}$" },
        "address": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" },
        "algorithm": { "enum": ["ecdsa-p256-sha256", "ecdsa-secp256k1-keccak256", "sm2-sm3"] },
        "signature": { "type": "string", "pattern": "^0x[0-9a-f]+$" },
        "signedFields": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
