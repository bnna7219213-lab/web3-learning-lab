# 复制为 .env 使用：cp .env.example .env
# 规则：本文件只放「变量名 + 假值」。真实私钥永远不进 .env.example，也不进 git。

# ---------- 网络 / RPC ----------
CHAIN_PROFILE=anvil                 # anvil | sepolia | base-sepolia | unionchain-local
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
WS_URL=

# ---------- 账户（学习钱包，金额必须为 0 价值）----------
# 仅测试网助记词/私钥；与任何真实资产钱包物理隔离
DEPLOYER_PRIVATE_KEY=
TEST_MNEMONIC=
# 合约所有权最终移交目标（多签/Timelock 地址，学习阶段可先填自己的 second account）
OWNER_ADDRESS=

# ---------- 数据服务（P09 起）----------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/web3roadmap
INDEXER_CONFIRMATIONS=12            # 重组安全深度，对齐 lainchain 索引器改造项
INDEXER_FROM_BLOCK=0

# ---------- 第三方 ----------
ETHERSCAN_API_KEY=
ALCHEMY_API_KEY=
CHAINLINK_FEED_ADDRESS=

# ---------- 合规模块产品线（docs/00-预备/modules/）----------
# 以下模块参数属于「商业交付配置」，学习阶段留空即可
SETTLEMENT_TOKEN_ADDRESS=           # M1 分账计价代币（稳定币/合规积分，禁止自发代币）
IOT_GATEWAY_ENDPOINT=               # M2 设备可信结算网关
IOT_DEVICE_ROOT_PUBKEY=             # 设备公钥白名单根证书（实际部署逐台注册设备）
ECNY_ADAPTER_MODE=mock              # M5：mock | bank-sandbox（须银行/数研所生态内）
