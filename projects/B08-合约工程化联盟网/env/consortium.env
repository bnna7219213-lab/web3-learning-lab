# 联盟网（Besu QBFT 4 验证者）：零 gas、London 级 EVM、无公网依赖
# 注意：密钥不入库。成员私钥放 env/.env.local（被 .gitignore 的 .env.* 规则排除）。
NETWORK_PROFILE=consortium
RPC_URL=http://127.0.0.1:8551
CHAIN_ID=19880601
EXPLORER_URL=
EXPLORER_VERIFY=false
GAS_MODE=zero
# 单笔 gas 上限（EIP-7825）：大合约部署必须确认 pertxgaslimit，见 docs/02
PER_TX_GAS_LIMIT=8000000

# P08 实验参数
GASLAB_N=64
